# mdtable target-document settings — rename to mdtable.env.
# Describes WHERE the markdown table to edit lives; the transform itself is
# passed as data in code. Used with lib/py/mdtable.py's RestDoc transport.
#
# Parsing: `FIELD=` — plain KEY=VALUE, whitespace-trimmed, # starts a comment.
# The token itself is loaded from the encrypted store (secret_load), never here.

# Base URL of the tracker / knowledge base instance.
# kind=issues pairs with field=description; kind=articles with field=content.
base_url=
kind=
field=
doc_id=
