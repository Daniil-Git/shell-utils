# webforms.load_form() context file — one VAR=value per line.
# Rename to forms.env. Sourced as a dict: each key fills the matching {var}
# in forms.json.example. Values containing { } or spaces need no quoting here.
# NEVER commit the filled version; secrets belong in the encrypted store
# (lib/secrets.sh), not in a data file.
#
# Parsing: `FIELD=` — plain KEY=VALUE, whitespace-trimmed, # starts a comment.
username=
password=
app_name=
