# lib/gitlab.sh environment — rename to gitlab.env and fill, or export directly.
#
# Parsing: `FIELD=` — plain KEY=VALUE, whitespace-trimmed, # starts a comment.
# GITLAB_URL is REQUIRED and has no default on purpose: a misconfigured shell
# must fail loudly, not talk to the wrong host. GITLAB_TOKEN never lives in a
# file — store it once with:  secret_set gitlab GITLAB_TOKEN

# Instance base URL. Must start with http:// or https://
GITLAB_URL=

# Secret-store namespace holding the token (default: gitlab)
GITLAB_SECRET_NS=

# Default lifetime in days for new / rotated tokens (default: 90)
GITLAB_TOKEN_DEFAULT_DAYS=

# Non-interactive gpg: file containing the store passphrase (mode 600).
# Unset = interactive /dev/tty prompt.
GITLAB_GPG_PASSPHRASE_FILE=
